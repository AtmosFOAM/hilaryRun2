FoamFile
{
    format      ascii;
    class       volVectorField;
    object      U;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 1 -1 0 0 0 0];

internalField uniform (8 0 0);

boundaryField
{
    ground
    {
        type            noSlip;
        value           uniform (0 0 0);
    }

    top
    {
        type            slip;
        value           uniform (8 0 0);
    }

    ".*"
    {
        type            cyclic;
    }

    #includeEtc "caseDicts/setConstraintTypes"
}

