FoamFile
{
    format      ascii;
    class       volScalarField;
    location    "0";
    object      k;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 2 -2 0 0 0 0];

internalField
{
    type coded;
    evaluate
    #{
        const dimensionedScalar zMax(dimLength, scalar(250));
        const dimensionedScalar kMax(dimensionSet(0,2,-2,0,0), scalar(0.4));
        const dimensionedScalar kMin(dimensionSet(0,2,-2,0,0), scalar(1e-4));
        const DimensionedField<double, Foam::fvMesh> z(C.component(vector::Z));
        field = max(kMax*pow(1 - z/zMax,3), kMin);
    #};
}

boundaryField
{
    ground
    {
        type            zeroGradient;
    }
    top
    {
        type            zeroGradient;
    }
    inlet
    {
        type            cyclic;
    }
    outlet
    {
        type            cyclic;
    }
    front
    {
        type           cyclic;
    }
    back
    {
        type           cyclic;
    }

    #includeEtc "caseDicts/setConstraintTypes"
}

