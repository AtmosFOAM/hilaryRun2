FoamFile
{
    format      ascii;
    class       volScalarField;
    location    "0";
    object      p_rgh;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [1 -1 -2 0 0 0 0];

internalField   uniform 0;

boundaryField
{
    ground
    {
        type    fixedGradient;
        gradient uniform -9.81; //-13.00806;
    }

    top
    {
        type    fixedGradient;
        gradient uniform 9.81; //12.90321548;
    }

    ".*"{type cyclic;}

    #includeEtc "caseDicts/setConstraintTypes"
}

