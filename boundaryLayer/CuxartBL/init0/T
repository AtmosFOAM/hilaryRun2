FoamFile
{
    format      ascii;
    class       volScalarField;
    location    "0";
    object      T;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 0 0 1 0 0 0];

internalField
{
    type coded;
    evaluate
    #{
        // This is actually theta, but this is a start
        const scalarField z(C.component(vector::Z));
        const scalar T0 = 265;
        field.primitiveFieldRef() = T0 + max(0.01*(z-100), scalar(0));
    #};
}

boundaryField
{
    ground
    {
        type            uniformFixedValue;
        uniformValue coded;
        name coolingGround;
        code
        #{
            scalar groundTemp = 265 - 0.25*x/3600;
            return groundTemp;
        #};
    }

    top
    {
        type            fixedGradient;
        gradient        uniform 0.01;
    }

    "(inlet|outlet|front|back)"
    {
        type            cyclic;
    }

}

