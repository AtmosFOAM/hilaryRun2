FoamFile
{
    format      ascii;
    class       volScalarField;
    location    "0";
    object      nut;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 2 -1 0 0 0 0];

internalField   uniform 0;

boundaryField
{
    ground
    {
        type            nutAtmosphericBoundaryLayerWallFunction;
        libs            ("libatmosphericModels.so");
        value           uniform 0;
    }
    top
    {
        type            zeroGradient;
    }
    ".*"
    {
        type            cyclic;
        value           uniform 0;
    }

    #includeEtc "caseDicts/setConstraintTypes"
}

