#!/bin/bash -e
rm -rf [0-9]*  constant/polyMesh

# Mesh generation
blockMesh

# Initialization
rm -rf 0; cp -r init0 0

# Run
foamRun >& log & sleep 0.01;tail -f log

# Plot graphs
function plotProfile {
    if [ "$#" -ne 2 ]; then
        echo usage: plotProfile time field
        return 1
    fi
    time=$1
    f=$2
    export time
    writeCellDataxyz -time $time $f
    sed '1d' $time/$f.xyz | sort -k3,3n | sponge $time/$f.xyz
    gmtPlot plots/plot${f}.gmt
    evince $time/$f.eps &
}

time=32400
for f in U T nut alphat k epsilon; do
    plotProfile $time $f
done

