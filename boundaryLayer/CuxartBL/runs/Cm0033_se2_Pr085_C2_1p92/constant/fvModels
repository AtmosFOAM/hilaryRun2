FoamFile
{
    format      ascii;
    class       dictionary;
    location    "constant";
    object      fvModels;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

Coriolis
{
    type    coded;
    cellZone all;
    field U;

    codeInclude
    #{
        #include "IOdictionary.H"
    #};

    codeAddSup
    #{
        Pout<< "**codeAddSup**" << endl;
    #};

    codeAddRhoSup
    #{
        Pout<< "**Coriolis codeAddRhoSup**" << endl;
        IOdictionary dict
        (
            mesh().lookupObject<IOdictionary>("physicalProperties")
        );
        const dimensionedVector F(dict.lookup<dimensionedVector>("Coriolis"));
        const scalarField& V = mesh().V();
        const vectorField& U = eqn.psi();
        vectorField& USource = eqn.source();
        USource -= (U ^ F.value())*V*rho.internalField();
    #};

    codeAddAlphaRhoSup
    #{
        Pout<< "**codeAddAlphaRhoSup**" << endl;
    #};
}

balancePressure
{
    type    coded;
    cellZone all;
    field U;

    codeInclude
    #{
        #include "IOdictionary.H"
        #include "uniformDimensionedFields.H"
    #};

    codeAddSup
    #{
        Pout<< "**codeAddSup**" << endl;
    #};

    codeAddRhoSup
    #{
        Pout<< "**balancePressure codeAddRhoSup**" << endl;
        IOdictionary dict
        (
            mesh().lookupObject<IOdictionary>("physicalProperties")
        );
        const dimensionedVector F(dict.lookup<dimensionedVector>("Coriolis"));
        const dimensionedVector Ug(dict.lookup<dimensionedVector>("Ugeo"));
        
        const uniformDimensionedVectorField& g =
            mesh().objectRegistry::template
            lookupObject<uniformDimensionedVectorField>("g");
        
        const scalarField& V = mesh().V();
        vectorField& USource = eqn.source();
        USource += (g.value()  + (Ug.value() ^ F.value()))*V*rho.internalField();
    #};

    codeAddAlphaRhoSup
    #{
        Pout<< "**codeAddAlphaRhoSup**" << endl;
    #};
}

