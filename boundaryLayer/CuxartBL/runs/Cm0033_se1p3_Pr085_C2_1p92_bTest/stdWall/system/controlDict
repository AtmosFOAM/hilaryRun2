FoamFile
{
    format      ascii;
    class       dictionary;
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

libs            ("libatmosRANS.so" "libfieldFunctionObjects2.so");

solver          fluid;

startFrom       startTime;

startTime       0;

stopAt          endTime;

endTime         32400; // 9 hours

deltaT          10;

writeControl    runTime;

writeInterval   3600;

purgeWrite      0;

writeFormat     ascii; //binary;

writePrecision   6;

writeCompression off;

timeFormat      general;

timePrecision   6;

runTimeModifiable true;


