inputFiles=($case/$time/epsilon.xyz)
outFile=$case/$time/epsilon.eps
col=3
colx=4
legends=()
#pens=(psxy pen types in double quotes)
#symbols=(psxy symbol types in double quotes) (optional)
#spens=(psxy pen types in double quotes for the symbols) (optional)
xlabel='@~e@~ (m@+2@+ s@+-3@+)'
ylabel='z (m)'
xmin=0 #1e-9
xmax=0.012
dx=0.002 #10
ddx=0.001 #2
dxg=0.002 #10
ymin=0
ymax=400
dy=50
ddy=10
dyg=50
#xscale=/86400
#yscale=*1
#legPos=x10/10
nSkip=0
projection=X15c/10c
gv=0
