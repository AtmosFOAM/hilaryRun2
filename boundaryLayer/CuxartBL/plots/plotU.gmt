inputFiles=($case/$time/U.xyz $case/$time/U.xyz)
outFile=$case/$time/U.eps
col=(3 3)
colx=(4 5)
legends=('u' 'v')
#pens=(psxy pen types in double quotes)
#symbols=(psxy symbol types in double quotes) (optional)
#spens=(psxy pen types in double quotes for the symbols) (optional)
xlabel='u/v (m/s)'
ylabel='z (m)'
xmin=-1
xmax=10
dx=5
ddx=1
dxg=2
ymin=0
ymax=400
dy=50
ddy=10
dyg=50
#xscale=/86400
#yscale=*1
#legPos=x10/10
nSkip=0
projection=X15c/10c
gv=0
