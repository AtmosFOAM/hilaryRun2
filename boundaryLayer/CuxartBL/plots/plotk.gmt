inputFiles=($time/k.xyz)
outFile=$time/k.eps
col=3
colx=4
#legends=(legend strings in double quotes)
#pens=(psxy pen types in double quotes)
#symbols=(psxy symbol types in double quotes) (optional)
#spens=(psxy pen types in double quotes for the symbols) (optional)
xlabel='k (m@+2@+/s@+2@+)'
ylabel='z (m)'
xmin=0 # 8e-5
xmax=0.5
dx=0.1 #10
#ddx=2
dxg=0
ymin=0
ymax=400
dy=50
ddy=10
dyg=0
#xscale=/86400
#yscale=*1
#legPos=x10/10
nSkip=0
projection=X15c/10c
gv=0
