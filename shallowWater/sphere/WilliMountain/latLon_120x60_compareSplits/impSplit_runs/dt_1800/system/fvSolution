FoamFile
{
    format          ascii;
    class           dictionary;
    location        "system";
    object          fvSolution;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

nOuterCorrs     2;
nPressureCorrs  1;
nNonOrthogCorrs 1;
timeOffCentre   0.5;
operatorSplit   on;

solvers
{
    "(h|U)"
    {
        solver          GAMG;
        smoother        GaussSeidel;
        tolerance       1e-08;
        relTol          0;
    }
}


