FoamFile
{
    format          ascii;
    class           dictionary;
    location        "system";
    object          controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

libs            ("libfieldFunctionObjects2.so");

application     AdImExShallowWaterFoam;

startFrom       startTime;

startTime       0;

subSolverTime   0;

stopAt          endTime;

endTime         1296000;

deltaT          900;

writeControl    runTime;

writeInterval   86400;

purgeWrite      0;

writeFormat     binary;

writePrecision  6;

writeCompression off;

timeFormat      general;

timePrecision   7;

runTimeModifiable false;


