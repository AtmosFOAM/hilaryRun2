FoamFile
{
    format      ascii;
    class       dictionary;
    location    "system";
    object      fvSolution;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

nNonLinIters 2;
nCoriIters 3;
forwardBackwardGravity off;

solvers
{
    "h"
    {
        solver    GAMG;
        smoother  GaussSeidel;
        tolerance 1e-8;
        relTol    0;
    }

    "(U|hU)"
    {
        solver    GAMG;
        smoother  GaussSeidel;
        tolerance 1e-8;
        relTol    0;
    }
}

